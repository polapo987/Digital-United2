<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>디지털부대 · 익명 게시판</title>
<style>
:root{--bg:#f4f6f4;--paper:#fff;--ink:#17231f;--muted:#718079;--line:#e5ebe7;--green:#175c43;--mint:#e9f4ed;--accent:#b9e6ce;--shadow:0 10px 34px #17231f0b}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans KR",sans-serif;letter-spacing:-.025em}.shell{max-width:1050px;margin:auto;padding:32px 26px 72px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:38px}.brand{display:flex;align-items:center;gap:12px;font-weight:800;font-size:16px}.logo{width:38px;height:38px;background:var(--green);color:white;border-radius:12px;display:grid;place-items:center;font-size:17px}.status{font-size:12px;color:var(--muted);display:flex;gap:8px;align-items:center}.dot{width:7px;height:7px;background:#55af77;border-radius:50%}.hero{background:var(--green);color:#fff;border-radius:23px;padding:36px 40px;position:relative;overflow:hidden;margin-bottom:23px}.hero:after{content:"";position:absolute;border:1px solid #ffffff18;width:270px;height:270px;border-radius:50%;right:55px;top:-140px;box-shadow:0 0 0 35px #ffffff08,0 0 0 72px #ffffff06}.eyebrow{text-transform:uppercase;color:#c5e9d4;font-size:11px;font-weight:700;letter-spacing:.14em}.hero h1{font-size:36px;letter-spacing:-.06em;margin:9px 0 8px}.hero p{margin:0;color:#d1e5da;font-size:14px}.hero-stats{display:flex;gap:24px;margin-top:25px;font-size:12px;color:#c5e9d4}.hero-stats strong{font-size:15px;color:#fff;margin-right:5px}.layout{display:grid;grid-template-columns:1fr 290px;gap:20px;align-items:start}.card{background:var(--paper);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow)}.composer{padding:21px;margin-bottom:15px}.section-title{font-size:14px;font-weight:750;margin:0 0 14px}.field{width:100%;border:1px solid var(--line);border-radius:11px;background:#fafcfb;padding:12px 13px;color:var(--ink);font:inherit;font-size:13px;outline:none}.field:focus{border-color:#81b798;background:#fff}textarea.field{resize:vertical;min-height:105px;line-height:1.65}.compose-foot{display:flex;align-items:center;justify-content:space-between;margin-top:11px}.hint{font-size:11px;color:var(--muted)}button{font:inherit;cursor:pointer;border:0}.primary{background:var(--green);color:white;font-size:12px;font-weight:700;padding:11px 16px;border-radius:10px}.primary:hover{background:#104b35}.feed-head{display:flex;align-items:center;justify-content:space-between;padding:8px 2px 12px}.feed-head h2{font-size:15px;margin:0}.feed-head span{font-size:11px;color:var(--muted)}.post{padding:19px 21px;margin-bottom:11px}.post-top{display:flex;justify-content:space-between;align-items:center}.author{display:flex;align-items:center;gap:9px;font-size:12px;font-weight:700}.avatar{width:29px;height:29px;border-radius:10px;background:var(--mint);color:var(--green);display:grid;place-items:center;font-weight:800}.time{font-size:10px;color:var(--muted);font-weight:400;margin-left:4px}.post-body{white-space:pre-wrap;line-height:1.75;font-size:14px;margin:14px 0 13px;word-break:break-word}.post-bottom{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #f0f3f1;padding-top:11px}.react{background:transparent;color:var(--muted);font-size:11px;padding:4px 0}.react:hover{color:var(--green)}.delete{background:transparent;color:#9a7777;font-size:11px}.delete:hover{color:#c33}.side{padding:20px;margin-bottom:14px}.side-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.side-head h2{font-size:14px;margin:0}.pill{background:var(--mint);color:var(--green);padding:5px 8px;border-radius:20px;font-size:10px;font-weight:700}.nick-display{font-size:19px;font-weight:800;margin:9px 0 5px}.sub{font-size:11px;color:var(--muted);line-height:1.55}.rule{height:1px;background:var(--line);margin:16px 0}.nick-form{display:flex;gap:7px;margin-top:12px}.nick-form .field{padding:10px;font-size:12px}.nick-form button{white-space:nowrap;padding:0 11px}.history-title{font-size:12px;font-weight:750;margin-bottom:10px}.history-item{border-left:2px solid var(--accent);padding:1px 0 2px 10px;margin:10px 0;font-size:11px;line-height:1.55}.history-item strong{color:var(--green)}.history-time{font-size:10px;color:var(--muted);margin-top:3px}.empty{padding:40px 20px;text-align:center;color:var(--muted);font-size:13px}.empty strong{display:block;color:var(--ink);margin-bottom:6px}.toast{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);background:#1c2923;color:white;padding:11px 17px;border-radius:12px;font-size:12px;opacity:0;transition:.2s;pointer-events:none}.toast.show{opacity:1}.footer{text-align:center;color:#98a29d;font-size:10px;margin-top:27px}@media(max-width:760px){.shell{padding:20px 15px 48px}.hero{padding:29px 25px}.hero h1{font-size:30px}.layout{grid-template-columns:1fr}.side-col{grid-row:1;display:grid;grid-template-columns:1fr 1fr;gap:12px}.side{margin:0}.side.history{grid-column:1/-1}.hero-stats{gap:14px}}@media(max-width:480px){.side-col{grid-template-columns:1fr}.side.history{grid-column:auto}.top{margin-bottom:24px}.status{font-size:10px}}
</style></head>
<body><div class="shell"><header class="top"><div class="brand"><div class="logo">ㄷ</div>디지털부대</div><div class="status"><span class="dot"></span>우리끼리 이야기하는 공간</div></header>
<section class="hero"><div class="eyebrow">DIGITAL UNIT · COMMUNITY</div><h1>편하게 이야기해요.</h1><p>별명으로 나누는 디지털부대의 익명 게시판</p><div class="hero-stats"><span><strong id="postCount">0</strong>개의 이야기</span><span><strong id="memberCount">1</strong>명의 별명</span></div></section>
<div class="layout"><main><form class="card composer" id="postForm"><h2 class="section-title">새 글 쓰기</h2><textarea class="field" id="body" maxlength="2000" placeholder="무슨 이야기를 나누고 싶나요?" required></textarea><div class="compose-foot"><span class="hint">별명으로 게시돼요 · 최대 2,000자</span><button class="primary" type="submit">게시하기 ↗</button></div></form><div class="feed-head"><h2>최근 이야기</h2><span id="feedMeta">최신순</span></div><div id="feed"></div></main><aside class="side-col"><section class="card side"><div class="side-head"><h2>내 별명</h2><span class="pill">익명</span></div><div class="nick-display" id="nickname">방문자</div><div class="sub" id="nickNote">원하는 별명을 정해보세요.</div><div class="rule"></div><form class="nick-form" id="nickForm"><input class="field" id="nickInput" maxlength="16" placeholder="새 별명" required><button class="primary" id="nickButton" type="submit">정하기</button></form></section><section class="card side history"><div class="side-head"><h2>별명 변경 기록</h2><span class="pill">공개</span></div><div class="sub">별명이 바뀌면 변경 전·후 이름과 시간이 여기에 남아요.</div><div class="rule"></div><div id="history"></div></section></aside></div><div class="footer">디지털부대 익명 게시판 · 이 브라우저에 저장됩니다</div></div><div id="toast" class="toast"></div>
<script>
(()=>{const KEY='digital-unit-board-v1';const HOUR=3600000;let data;try{data=JSON.parse(localStorage.getItem(KEY))||{nickname:'',changedAt:0,posts:[],history:[]}}catch{data={nickname:'',changedAt:0,posts:[],history:[]}}if(!data.posts)data.posts=[];if(!data.history)data.history=[];if(!data.nickname)data.nickname='방문자';const id=localStorage.getItem(KEY+'-id')||crypto.randomUUID();localStorage.setItem(KEY+'-id',id);const $=s=>document.querySelector(s);const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));function save(){localStorage.setItem(KEY,JSON.stringify(data))}function ago(t){const n=Date.now()-t;if(n<60000)return '방금';if(n<3600000)return Math.floor(n/60000)+'분 전';if(n<86400000)return Math.floor(n/3600000)+'시간 전';return new Date(t).toLocaleDateString('ko-KR',{month:'long',day:'numeric'})}function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200)}function render(){const posts=[...data.posts].sort((a,b)=>b.time-a.time);$('#postCount').textContent=posts.length;$('#memberCount').textContent=new Set(posts.map(p=>p.name)).size||1;$('#nickname').textContent=data.nickname;const wait=Math.max(0,HOUR-(Date.now()-data.changedAt));$('#nickNote').textContent=data.changedAt&&wait>0?`다음 변경까지 ${Math.ceil(wait/60000)}분 남았어요.`:'별명은 1시간에 한 번 변경할 수 있어요.';$('#nickInput').disabled=wait>0;$('#nickButton').disabled=wait>0;$('#nickButton').style.opacity=wait>0?'.5':'1';$('#nickButton').textContent=wait>0?'잠금':'변경';$('#feed').innerHTML=posts.length?posts.map(p=>`<article class="card post"><div class="post-top"><div class="author"><span class="avatar">${esc(p.name.slice(0,1))}</span><span>${esc(p.name)} <span class="time">· ${ago(p.time)}</span></span></div></div><div class="post-body">${esc(p.body)}</div><div class="post-bottom"><button class="react" data-like="${p.id}">♡ 공감 ${p.likes||0}</button>${p.owner===id?`<button class="delete" data-delete="${p.id}">삭제</button>`:''}</div></article>`).join(''):`<div class="card empty"><strong>아직 글이 없어요</strong>첫 이야기를 남겨보세요.</div>`;$('#history').innerHTML=data.history.length?data.history.slice(0,8).map(h=>`<div class="history-item"><strong>${esc(h.from)}</strong> → <strong>${esc(h.to)}</strong><div class="history-time">${new Date(h.time).toLocaleString('ko-KR',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'})}</div></div>`).join(''):'<div class="sub">아직 변경 기록이 없어요.</div>'}$('#postForm').addEventListener('submit',e=>{e.preventDefault();const body=$('#body').value.trim();if(!body)return;data.posts.push({id:crypto.randomUUID(),owner:id,name:data.nickname,body,time:Date.now(),likes:0});save();$('#body').value='';render();toast('게시했어요.')});$('#nickForm').addEventListener('submit',e=>{e.preventDefault();const next=$('#nickInput').value.trim();if(!next)return;if(Date.now()-data.changedAt<HOUR){toast('별명은 1시간에 한 번 변경할 수 있어요.');return}if(next===data.nickname){toast('현재 별명과 같아요.');return}const prev=data.nickname;data.nickname=next;data.changedAt=Date.now();data.history.unshift({from:prev,to:next,time:Date.now()});save();$('#nickInput').value='';render();toast(`${prev}에서 ${next}(으)로 변경했어요.`)});$('#feed').addEventListener('click',e=>{const d=e.target.closest('[data-delete]');if(d){if(confirm('이 글을 삭제할까요?')){data.posts=data.posts.filter(p=>p.id!==d.dataset.delete);save();render();toast('글을 삭제했어요.')}return}const l=e.target.closest('[data-like]');if(l){const p=data.posts.find(x=>x.id===l.dataset.like);if(p){p.likes=(p.likes||0)+1;save();render()}}});render()})();
</script></body></html>
